generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Supabase Auth manages users (auth.users). App tables use Supabase user UUID.

model Watchlist {
  id         String   @id @default(cuid())
  user_id    String
  asset_id   String
  asset_name String
  added_at   DateTime @default(now())

  @@unique([user_id, asset_id])
  @@index([user_id])
}

model CryptoAlert {
  id              String   @id @default(cuid())
  asset_id        String
  asset_name      String
  price_at_drop   Float
  drop_percentage Float
  detected_at     DateTime @default(now())
}
