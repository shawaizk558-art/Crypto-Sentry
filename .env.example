# Database (PostgreSQL — Supabase pooler or any Postgres host)
# Session pooler (port 5432) has a low client cap — keep DATABASE_POOL_MAX small (1–3).
# For heavier traffic, use the transaction pooler on port 6543 with ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DATABASE_POOL_MAX="2"

# Supabase Storage — profile avatars (required on Vercel; local disk is ephemeral)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Run supabase/avatars-bucket.sql once in the Supabase SQL Editor.

# NextAuth (Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Legacy alias also supported:
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Required for next-auth/react client helpers (signIn); set to the same value as AUTH_URL:
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — Google Cloud Console → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# CoinGecko — Node poller: 1 call every MARKET_POLL_INTERVAL_MS → top 100 → in-memory cache
MARKET_POLL_INTERVAL_MS="60000"
COINGECKO_API_BASE_URL="https://api.coingecko.com/api/v3"
COINGECKO_MARKETS_PATH="/coins/markets"
COINGECKO_API_KEY=""
COINGECKO_API_TIER="demo"
LOG_VERBOSE=""
