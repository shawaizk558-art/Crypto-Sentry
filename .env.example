# Database (Supabase PostgreSQL — same project as Auth)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Enable in Supabase Dashboard:
# Auth → Providers → Email (enable, allow signups)
# Auth → Providers → Google (add OAuth client)
# Auth → Email → enable Email OTP (6-digit code for signup verification)
# URL config: redirect http://localhost:3000/auth/callback
# Profile photos: run supabase/avatars-bucket.sql in Supabase SQL Editor (creates public avatars bucket + RLS)

# CoinGecko — Node poller: 1 call every MARKET_POLL_INTERVAL_MS → top 100 → in-memory cache
MARKET_POLL_INTERVAL_MS="30000"
COINGECKO_API_BASE_URL="https://api.coingecko.com/api/v3"
COINGECKO_MARKETS_PATH="/coins/markets"
COINGECKO_API_KEY=""
COINGECKO_API_TIER="demo"
LOG_VERBOSE=""
