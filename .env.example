# PostgreSQL (local: docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypto_sentry"
DATABASE_POOL_MAX="5"

# NextAuth (Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Legacy alias also supported:
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Required for next-auth/react client helpers (signIn); set to the same value as AUTH_URL:
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — Google Cloud Console → Credentials → OAuth 2.0 Client
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email verification (SendGrid) — verify a Single Sender in SendGrid, then use that address here
# Without SENDGRID_API_KEY, verification links are logged in the dev console
SENDGRID_API_KEY=""
EMAIL_FROM="Crypto Sentry <your-verified@gmail.com>"

# External cron (cron-job.org) — pings /api/cron/refresh-prices every 60s on Vercel Hobby
CRON_SECRET="generate-with-openssl-rand-base64-32"

# CoinGecko — Node poller: 1 call every MARKET_POLL_INTERVAL_MS → top 100 → in-memory cache
MARKET_POLL_INTERVAL_MS="60000"
COINGECKO_API_BASE_URL="https://api.coingecko.com/api/v3"
COINGECKO_MARKETS_PATH="/coins/markets"
COINGECKO_API_KEY=""
COINGECKO_API_TIER="demo"
LOG_VERBOSE=""
